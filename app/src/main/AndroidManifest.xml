<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application
        android:name=".app.LLMEdgeExampleApp"
        android:label="llmedge Example"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
    >
        <!-- FileProvider for sharing camera temp files with camera app -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true"
        >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"
            />
        </provider>
        <activity
            android:name=".demo.text.HuggingFaceDemoActivity"
            android:exported="false"
        />
        <activity
            android:name=".demo.text.LocalAssetDemoActivity"
            android:exported="false"
        />
        <activity
            android:name=".demo.text.JinjaTemplateDemoActivity"
            android:exported="false"
        />
        <activity android:name=".demo.rag.RagActivity" android:exported="false" />
        <activity
            android:name=".demo.vision.ImageToTextActivity"
            android:exported="false"
        />
            <activity android:name=".demo.vision.LlavaVisionActivity" />
        <activity
            android:name=".demo.video.VideoGenerationActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".demo.image.ImageGenerationActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".demo.tools.ToolCallingDemoActivity"
            android:exported="false" />
        <activity
            android:name=".demo.video.HeadlessVideoTestActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
        />
        <activity android:name=".app.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".demo.text.SmolJavaExampleActivity"
            android:exported="false"
        />
        <activity
            android:name=".demo.speech.TranscriptionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".demo.speech.TTSActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>
</manifest>
